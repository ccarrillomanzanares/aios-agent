#!/bin/bash
# AIOS Session: arranca el escritorio (X + i3).
# El setup del primer arranque (si no hay config) lo gestiona i3 en xterm
# (linea 54 del i3 config: setup.py en aios-xterm). Decision Carlos 26 Ago:
# el menu sale DESPUES de i3, nunca antes (el setup-before-X de consola
# tty1 se elimino — hacia que el menu apareciera sin startx).
LOG="/home/aios/startx.log"

# Esperar a que udev aplique permisos a /dev/dri (race en boot:
# X moria con "open /dev/dri/card0: Permission denied" -> no screens found
# -> getty start-limit-hit -> cursor parpadeando). Max 30s.
for i in $(seq 1 30); do
    if [ -c /dev/dri/card0 ] && [ -r /dev/dri/card0 ] && [ -w /dev/dri/card0 ]; then
        break
    fi
    sleep 1
done

exec /usr/bin/startx "$@" > "$LOG" 2>&1
