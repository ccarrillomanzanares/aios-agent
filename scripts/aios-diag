#!/usr/bin/env bash
# aios-diag — collects AIOS diagnostics (system + logs + screenshots),
# compresses them with a timestamp and uploads them to the VPS (write-only account).
#
# Usage:
#   aios-diag            collect + compress + upload (if key exists)
#   aios-diag --local    collect + compress, no upload
#
# Environment variables:
#   AIOS_DIAG_USER (def: diag)   AIOS_DIAG_HOST (def: 31.220.80.78)
#   AIOS_DIAG_KEY  (def: ~/.ssh/aios_diag)
#
# The upload uses rsync against a dedicated 'diag' account restricted with
# rrsync (forced command) → it can ONLY write into an inbound folder,
# with no shell, no sudo, no read access to the VPS. No key is embedded in the ISO.

set -u

TS=$(date +%Y%m%d_%H%M%S)
HOST=$(hostname 2>/dev/null || echo aios)
OUT="$HOME/.aios-diag-work"          # temporary, cleaned up at the end
STATE="$HOME/.aios-diag-state"       # persistent (screenshot marker)
MARKER="$STATE/last_marker"
SHOTS_DIR="$HOME/screenshots"
BUNDLE="$HOME/aios-diag-${TS}.tar.zst"

DIAG_USER="${AIOS_DIAG_USER:-diag}"
DIAG_HOST="${AIOS_DIAG_HOST:-31.220.80.78}"
DIAG_KEY="${AIOS_DIAG_KEY:-$HOME/.ssh/aios_diag}"

UPLOAD=1
[ "${1:-}" = "--local" ] && UPLOAD=0

mkdir -p "$OUT/files" "$OUT/screenshots" "$STATE"
[ -f "$MARKER" ] || touch -d "1970-01-01 00:00:00" "$MARKER"

run() { local name="$1"; shift; "$@" > "$OUT/files/$name.txt" 2>&1; }

echo "Collecting diagnostics..."

# ── base system ─────────────────────────────────────────────────────────
run uname         uname -a
run os-release    cat /etc/os-release
run date-uptime   sh -c 'date; echo; uptime'
run mem           free -h
run disk          df -h
run loadavg       cat /proc/loadavg
run cpu           lscpu
run pci           lspci -nn
run usb           lsusb
run block         lsblk -f
run ip-addr       ip addr
run ip-route      ip route
run wifi          sh -c 'iw dev 2>&1'
run dns           sh -c 'resolvectl status 2>&1 || cat /etc/resolv.conf 2>&1'
run procs         ps aux --sort=-%mem

# ── audio (beep/tick) ──────────────────────────────────────────────────
run alsa-cards      cat /proc/asound/cards
run alsa-devices    aplay -l
run alsa-capture    arecord -l
run alsa-conf       sh -c 'echo "== /etc/asound.conf =="; cat /etc/asound.conf 2>&1; echo; echo "== ~/.asoundrc =="; cat "$HOME/.asoundrc" 2>&1'
run alsa-mixer      sh -c 'amixer -c 0 contents 2>&1 | grep -A5 -iE "Master|PCM|Capture|Mic|Beep|Headphone" | head -160'
run alsa-errors     sh -c 'dmesg | grep -iE "snd|hda|audio|alsa" | tail -60 2>&1'
run audio-play-test python3 -c "import math,struct,subprocess; pcm=b''.join(struct.pack('<h',int(8000*math.sin(2*math.pi*880*i/44100))) for i in range(4410)); p=subprocess.run(['aplay','-q','-f','S16_LE','-r','44100','-c','1'],input=pcm,timeout=10); print('aplay test exit:',p.returncode)"
run audio-mic-test  sh -c 'python3 - <<"PY"
import subprocess, wave, struct, math, os
wav = "/tmp/aios-diag-mic.wav"
try:
    p = subprocess.run(["arecord","-q","-f","S16_LE","-r","16000","-c","1","-d","2",wav], timeout=10)
    print("arecord exit:", p.returncode)
except Exception as e:
    print("arecord FAIL:", e); raise SystemExit
if os.path.exists(wav):
    w = wave.open(wav); n = w.getnframes()
    d = w.readframes(n)
    if d:
        s = struct.unpack("<%dh" % (len(d)//2), d)
        rms = math.sqrt(sum(x*x for x in s)/len(s))
        print("mic: %.2fs RMS=%d %s" % (n/w.getframerate(), rms, "SILENCE" if rms < 200 else "SIGNAL OK"))
    else:
        print("mic: no data")
    os.remove(wav)
PY'

# ── voice / TTS / STT ──────────────────────────────────────────────────
run voice-config    sh -c 'echo "== config.yaml =="; grep -A6 "^voice:" "$HOME/.aios/config.yaml" 2>&1; echo; echo "== voice_state.json =="; cat /usr/local/bin/aios-agent/data/voice_state.json 2>&1'
run tts-espeak      sh -c 'espeak-ng --version 2>&1 | head -3'
run voice-procs     sh -c 'ps aux | grep -E "[e]speak-ng|[a]play|[c]hat.py|[l]lama-server" 2>&1'
run vosk-module     python3 -c 'import vosk; print("vosk module OK")'
run vosk-model      sh -c 'ls -la /usr/local/share/aios/ 2>&1; du -sh /usr/local/share/aios/vosk-model* 2>&1'

# ── chat / agent (silent errors, hung voice) ───────────────────────────
run chat-fixes      sh -c 'echo "== applied patches =="; grep -n "LLM connection error\|voice.stop\|_save_session()" /usr/local/bin/aios-agent/chat.py /usr/local/bin/aios-agent/voice.py 2>&1'
run stream-errors   sh -c 'echo "== last lines =="; tail -5 /tmp/aios-stream.log 2>&1; echo; echo "== counters =="; for pat in "LLM connection error" "EXC" "Empty stream" "finish=length" "finish=tool_calls"; do printf "%-22s %s\n" "$pat:" "$(grep -c "$pat" /tmp/aios-stream.log 2>/dev/null)"; done'
run busy-file       sh -c 'ls -la /tmp/aios-agent.busy 2>&1; echo "-- contents:"; cat /tmp/aios-agent.busy 2>&1'

# ── errors / logs ──────────────────────────────────────────────────────
run dmesg-tail    sh -c 'dmesg | tail -200 2>&1'
run journal-err   journalctl -p err -b --no-pager
run unit-failed   systemctl list-units --failed --no-pager
run unit-running  systemctl list-units --state=running --no-pager

# ── AIOS specific ─────────────────────────────────────────────────────
run sven-list     sh -c 'sven list 2>&1'
run sven-log      sh -c 'tail -200 /var/log/sven/sven.log 2>&1'
run llama-status  systemctl status aios-llama --no-pager
run agent-status  systemctl status aios-agent --no-pager
run sync-status   systemctl status sven-sync --no-pager
run stream-log    sh -c 'tail -500 /tmp/aios-stream.log 2>&1'
run agent-files   sh -c 'ls -la /usr/local/bin/aios-agent/ /usr/local/bin/aios-agent/data/ /usr/local/bin/aios-agent/scripts/ 2>&1'
run session-log   sh -c 'for f in /usr/local/bin/aios-agent/data/session_*.json /usr/local/bin/aios-agent/skills_memory_*.json; do echo "=== $f ==="; head -300 "$f" 2>&1; done'
run i3-config     sh -c 'cat "$HOME/.config/i3/config" 2>&1'

# ── REDACTED config (keys/tokens) ──────────────────────────────────────
if [ -f "$HOME/.aios/config.yaml" ]; then
    sed -E 's/^([[:space:]]*[-A-Za-z_]*(key|token|secret|pass)[-A-Za-z_]*[[:space:]]*:[[:space:]]*).*/\1***REDACTED***/I' \
        "$HOME/.aios/config.yaml" > "$OUT/files/config-redacted.yaml" 2>/dev/null
fi

# ── screenshots since last collection ──────────────────────────────────
if [ -d "$SHOTS_DIR" ]; then
    find "$SHOTS_DIR" -maxdepth 1 -type f -name "*.png" -newer "$MARKER" \
        -exec cp {} "$OUT/screenshots/" \; 2>/dev/null
fi
N_SHOTS=$(ls "$OUT/screenshots" 2>/dev/null | wc -l)

# ── package ────────────────────────────────────────────────────────────
{
    echo "AIOS diagnostic bundle"
    echo "Date:   $(date '+%Y-%m-%d %H:%M:%S')"
    echo "Host:   $HOST"
    echo "User:   $(id -un 2>/dev/null)"
    echo "Screenshots: $N_SHOTS"
} > "$OUT/README.txt"

if tar --zstd -cf "$BUNDLE" -C "$OUT" . 2>/dev/null; then
    :
else
    BUNDLE="${BUNDLE%.zst}.tar.gz"
    tar czf "$BUNDLE" -C "$OUT" . 2>/dev/null
fi

# ── mark screenshots as collected ──────────────────────────────────────
touch "$MARKER"

echo "✓ Bundle: $BUNDLE ($(du -h "$BUNDLE" 2>/dev/null | cut -f1))"

# ── upload (if key + network) ──────────────────────────────────────────
if [ "$UPLOAD" = 1 ] && [ -f "$DIAG_KEY" ]; then
    if rsync -e "ssh -i '$DIAG_KEY' -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15" \
              "$BUNDLE" "$DIAG_USER@$DIAG_HOST:./" 2>/dev/null; then
        echo "✓ Uploaded to $DIAG_USER@$DIAG_HOST (write-only)"
    else
        echo "⚠ Could not upload (key or network?). Bundle remains local."
    fi
elif [ "$UPLOAD" = 1 ]; then
    echo "ℹ No upload key ($DIAG_KEY). Bundle is local only."
fi

rm -rf "$OUT"
