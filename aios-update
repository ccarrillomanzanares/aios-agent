#!/bin/bash
# ============================================================
#  aios-update — updates AIOS components
#  (agent + scripts + configs) from the official repos.
#  Usage: sudo aios-update        (requires internet)
#  Safe: only touches files managed by the AIOS project,
#  NEVER sven packages or system files. Previous files
#  are saved in /var/backups/aios-update/<date>/.
# ============================================================
set -u

CACHE=/var/cache/aios-update
BACKUP=/var/backups/aios-update
REPO_AGENT=https://github.com/ccarrillomanzanares/aios-agent.git
REPO_LFS=https://github.com/ccarrillomanzanares/aios-lfs.git
DATE=$(date +%Y%m%d-%H%M)
SELF=/usr/local/bin/aios-update   # this script (handled separately, see loop)
SELF_PENDING=0                    # 1 = a new aios-update is waiting to be installed

# Subtle colors
GRN='\033[0;32m'; YEL='\033[1;33m'; CYA='\033[0;36m'; RST='\033[0m'

say()  { printf "${CYA}[aios-update]${RST} %s\n" "$*"; }
ok()   { printf "${GRN}  ✓ %s${RST}\n" "$*"; }
warn() { printf "${YEL}  ⚠ %s${RST}\n" "$*"; }

# Check root
if [ "$(id -u)" -ne 0 ]; then
  echo "aios-update requires root (run: sudo aios-update)" >&2
  exit 1
fi

# Check network quickly (no curl/ping dependency)
if ! git ls-remote "$REPO_AGENT" HEAD >/dev/null 2>&1; then
  echo "ERROR: cannot reach $REPO_AGENT — check your internet connection." >&2
  exit 1
fi

say "Updating AIOS from the official repositories..."

# 1. Clone/update repos (working copy)
mkdir -p "$CACHE" "$BACKUP/$DATE"
if [ ! -d "$CACHE/aios-agent/.git" ]; then
  git clone --depth 1 "$REPO_AGENT" "$CACHE/aios-agent" -q || { echo "ERROR cloning aios-agent" >&2; exit 1; }
  ok "cloned aios-agent"
else
  git -C "$CACHE/aios-agent" pull --ff-only -q || warn "aios-agent pull failed (continuing with local copy)"
fi
if [ ! -d "$CACHE/aios-lfs/.git" ]; then
  git clone --depth 1 "$REPO_LFS" "$CACHE/aios-lfs" -q || { echo "ERROR cloning aios-lfs" >&2; exit 1; }
  ok "cloned aios-lfs"
else
  git -C "$CACHE/aios-lfs" pull --ff-only -q || warn "aios-lfs pull failed (continuing with local copy)"
fi

# 2. Manifest: (source in cache, destination in the system)
#    agent = aios-agent repo · lfs = aios-lfs repo (configs/)
#    Mapping verified against the tree (Sep 11 2026)
MANIFEST=(
  # --- Agent core (aios-agent repo root → /usr/local/bin/aios-agent/) ---
  "agent/agent.py        /usr/local/bin/aios-agent/agent.py"
  "agent/chat.py         /usr/local/bin/aios-agent/chat.py"
  "agent/setup.py        /usr/local/bin/aios-agent/setup.py"
  "agent/tools.py        /usr/local/bin/aios-agent/tools.py"
  "agent/memory.py       /usr/local/bin/aios-agent/memory.py"
  "agent/process.py      /usr/local/bin/aios-agent/process.py"
  "agent/voice.py        /usr/local/bin/aios-agent/voice.py"
  "agent/software_inventory.py /usr/local/bin/aios-agent/software_inventory.py"
  "agent/torrent.py      /usr/local/bin/aios-agent/torrent.py"
  "agent/aio_download.py /usr/local/bin/aios-agent/aio_download.py"
  "agent/CHANGELOG.md    /usr/local/bin/aios-agent/CHANGELOG.md"
  # --- Installer and system scripts (repo root/scripts → /usr/local/bin/) ---
  "agent/aios-install        /usr/local/bin/aios-install"
  "agent/aios-theme          /usr/local/bin/aios-theme"
  "agent/aios-time           /usr/local/bin/aios-time"
  "agent/aios-xterm          /usr/local/bin/aios-xterm"
  "agent/scripts/aios-keyboard /usr/local/bin/aios-keyboard"
  "agent/scripts/aios-session  /usr/local/bin/aios-session"
  "agent/aios-update         /usr/local/bin/aios-update"
  "agent/CHANGELOG.md        /usr/local/bin/CHANGELOG.md"
  # --- Helper scripts (scripts/ → aios-agent/scripts/) ---
  "agent/scripts/firstboot.sh    /usr/local/bin/aios-agent/scripts/firstboot.sh"
  "agent/scripts/launch_llama.py /usr/local/bin/aios-agent/scripts/launch_llama.py"
  "agent/scripts/grabar.sh           /usr/local/bin/aios-agent/scripts/grabar.sh"
  "agent/scripts/toggle-grabacion.sh /usr/local/bin/aios-agent/scripts/toggle-grabacion.sh"
  "agent/scripts/parar_grabacion.sh  /usr/local/bin/aios-agent/scripts/parar_grabacion.sh"
  "agent/scripts/instalar-grabacion.sh /usr/local/bin/aios-agent/scripts/instalar-grabacion.sh"
  "agent/scripts/aios-diag            /usr/local/bin/aios-agent/scripts/aios-diag"
  "agent/scripts/audio-detect.py       /usr/local/bin/aios-agent/scripts/audio-detect.py"
  "agent/scripts/screenshot.sh         /usr/local/bin/aios-agent/scripts/screenshot.sh"
  "agent/scripts/setup-audio-voice.sh  /usr/local/bin/aios-agent/scripts/setup-audio-voice.sh"
  # --- Configs (aios-lfs repo, configs/ → /home/aios/.config/) ---
  "lfs/configs/home/aios/.config/i3/config              /home/aios/.config/i3/config"
  "lfs/configs/home/aios/.config/i3/shortcuts.txt       /home/aios/.config/i3/shortcuts.txt"
  "lfs/configs/home/aios/.config/i3/status.py           /home/aios/.config/i3/status.py"
  "lfs/configs/home/aios/.config/i3/volume_bindings.conf /home/aios/.config/i3/volume_bindings.conf"
  # --- System config (aios-lfs, configs/etc → /etc) ---
  "lfs/configs/etc/aios-torrent.conf                                  /etc/aios-torrent.conf"
  "lfs/configs/etc/systemd/system/transmission-daemon.service.d/user.conf /etc/systemd/system/transmission-daemon.service.d/user.conf"
)

changed=0; same=0
for entry in "${MANIFEST[@]}"; do
  # read -r collapses manifest alignment spaces (fix Aug 26:
  # ${entry#* } used to leave spaces stuck to dst -> [ -f ] false -> never updated)
  read -r src dst <<< "$entry"
  case "$src" in
    agent/*) file="$CACHE/aios-agent/${src#agent/}" ;;
    lfs/*)   file="$CACHE/aios-lfs/${src#lfs/}" ;;
  esac
  [ -f "$file" ] || { warn "missing in repo: $src (skipping)"; continue; }

  # aios-update cannot overwrite itself while running: bash reads this script
  # incrementally, so replacing the file mid-run makes it re-read the new file
  # from the old byte offset -> syntax error and the whole loop aborts.
  # Defer it and re-exec the new copy at the very end.
  if [ "$dst" = "$SELF" ]; then
    if [ "$(md5sum < "$file" | cut -d' ' -f1)" = "$(md5sum < "$SELF" | cut -d' ' -f1)" ]; then
      same=$((same+1))
    else
      SELF_PENDING=1
    fi
    continue
  fi

  if [ -f "$dst" ] && [ "$(md5sum < "$file" | cut -d' ' -f1)" = "$(md5sum < "$dst" | cut -d' ' -f1)" ]; then
    same=$((same+1))
    continue
  fi

  # Changed: backup + copy + permissions
  if [ -f "$dst" ]; then
    mkdir -p "$BACKUP/$DATE/$(dirname "${dst#/}")"
    cp -a "$dst" "$BACKUP/$DATE/${dst#/}"
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$file" "$dst"
  chmod 755 "$dst" 2>/dev/null || true
  changed=$((changed+1))
  ok "updated ${dst}"
done

# 3. Restart/notices
agent_touched=0
for f in /usr/local/bin/aios-agent/agent.py /usr/local/bin/aios-agent/chat.py /usr/local/bin/aios-agent/setup.py /usr/local/bin/aios-agent/torrent.py; do
  if [ -f "$BACKUP/$DATE${f}" ]; then agent_touched=1; fi
done
# systemd drop-ins may have changed (e.g. transmission-daemon user override):
# reload so a later `systemctl start` picks the new unit up.
if [ -f "$BACKUP/$DATE/etc/systemd/system/transmission-daemon.service.d/user.conf" ]; then
  systemctl daemon-reload 2>/dev/null && ok "systemd units reloaded"
  if systemctl is-active --quiet transmission-daemon 2>/dev/null; then
    warn "transmission-daemon is running — restart it to apply the new settings: sudo systemctl restart transmission-daemon"
  fi
fi
i3_touched=0
for f in /home/aios/.config/i3/config /home/aios/.config/i3/status.py; do
  if [ -f "$BACKUP/$DATE${f}" ]; then i3_touched=1; fi
done

echo ""
if [ "$changed" -eq 0 ]; then
  ok "AIOS is already up to date ($same files checked, no changes)."
else
  ok "$changed file(s) updated, $same unchanged. Backups in $BACKUP/$DATE/"
  if [ "$agent_touched" -eq 1 ]; then
    warn "The agent code changed — restart the AIOS chat to apply it (close it and open AIOS again)."
  fi
  if [ "$i3_touched" -eq 1 ]; then
    warn "i3 config/status changed — reload i3 (Super+Shift+r) to apply."
  fi
fi

# 4. Self-update last: by now this script has been fully read, so replacing it
#    is safe. Re-exec the new copy once so the deferred update takes effect.
if [ "$SELF_PENDING" = 1 ] && [ -f "$CACHE/aios-agent/aios-update" ]; then
  if [ "${AIOS_UPDATE_REEXEC:-0}" = "1" ]; then
    warn "aios-update itself changed again during re-exec; install it manually"
  else
    mkdir -p "$BACKUP/$DATE/usr/local/bin"
    cp -a "$SELF" "$BACKUP/$DATE/usr/local/bin/aios-update" 2>/dev/null || true
    cp "$CACHE/aios-agent/aios-update" "$SELF"
    chmod 755 "$SELF" 2>/dev/null || true
    ok "updated $SELF (re-running to apply)"
    export AIOS_UPDATE_REEXEC=1
    exec "$SELF" "$@"
  fi
fi

exit 0
