import json
import os
import re
import subprocess
import sys
from pathlib import Path

VERSION = "1.1.3"
CONFIG_SRC = Path.home() / ".aios" / "config.yaml"
MODEL_SRC = Path("/usr/local/share/aios/models")
AGENT_SRC = Path("/usr/local/bin/aios-agent")

def run(cmd, check=True, capture=True):
    try:
        return subprocess.run(cmd, capture_output=capture, text=True, check=check)
    except subprocess.CalledProcessError as e:
        print(f"  ERROR: {' '.join(cmd)}")
        print(f"  {e.stderr.strip()}")
        sys.exit(1)

def run_capture(cmd):
    return run(cmd).stdout.strip()

def ask(question, default=""):
    suffix = f" [{default}]" if default else ""
    try:
        return _read_line(f"  {question}{suffix}: ").strip() or default
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)

def _read_line(prompt=""):
    """Read a line with correct backspace and protected prompt (fix 25 Aug).
    Raw mode + manual handling: backspace removes from the buffer (never the prompt)."""
    import termios
    import tty
    if prompt:
        sys.stdout.write(prompt)
        sys.stdout.flush()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    buf = []
    try:
        tty.setraw(fd)
        while True:
            ch = sys.stdin.read(1)
            if ch in ("\r", "\n"):
                break
            if ch in ("\x7f", "\x08"):   # backspace / DEL
                if buf:
                    buf.pop()
                    sys.stdout.write("\b \b")
                    sys.stdout.flush()
                continue
            if ch == "\x03":              # Ctrl+C
                raise KeyboardInterrupt
            if ch == "\x04":              # Ctrl+D
                break
            if ch.isprintable() or ch in (" ", "\t"):
                buf.append(ch)
                sys.stdout.write(ch)
                sys.stdout.flush()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    sys.stdout.write("\n")
    sys.stdout.flush()
    return "".join(buf)


def _fix_erase():
    """Set the tty erase character to DEL (0x7f) — canonical installer prompts
    (getpass, sudo, login) do not erase with backspace if the erase char does
    not match the key (bug '^ and letters', 26 Aug 2026). Also covers the
    setup xterm, which does not read .bashrc or /etc/profile."""
    try:
        import termios
        fd = sys.stdin.fileno()
        attrs = termios.tcgetattr(fd)
        attrs[6][termios.VERASE] = b"\x7f"
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
    except Exception:
        pass

def _read_password(prompt, min_len=8):
    """Read a password with echo masked as '*', safe after raw-mode menus.
    This avoids getpass(), which is sensitive to a dirty tty state left by
    _read_line() / tty.setraw() and produced the 'password does not work' bug
    after disk installation (Sep 2026)."""
    import termios, tty
    while True:
        if prompt:
            sys.stdout.write(prompt)
            sys.stdout.flush()
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        buf = []
        try:
            # raw mode so we can control every keystroke, including backspace
            tty.setraw(fd)
            while True:
                ch = sys.stdin.read(1)
                if ch in (chr(13), "\n"):        # Enter
                    break
                if ch in ("\x7f", "\x08"):   # Backspace / DEL
                    if buf:
                        buf.pop()
                        sys.stdout.write("\b \b")
                        sys.stdout.flush()
                    continue
                if ch == "\x03":             # Ctrl+C
                    raise KeyboardInterrupt
                if ch == "\x04":             # Ctrl+D
                    break
                if ch.isprintable():
                    buf.append(ch)
                    sys.stdout.write("*")
                    sys.stdout.flush()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\n")
        sys.stdout.flush()
        password = "".join(buf)
        if len(password) < min_len:
            print(f"  Too short (min {min_len} characters).")
            continue
        return password
def confirm(question):
    return ask(f"{question} (y/N)", "n").lower() in ("y", "yes")


def ask_typed(question, expected):
    """Strong confirmation: the user must type the exact expected word."""
    return ask(f"{question} (type '{expected}' to confirm)").strip().lower() == expected.lower()

def _vlen(s):
    """VISIBLE length: strip ANSI, count 2 columns for double-wide (emoji/CJK).
    len() overcounts ANSI and undercounts double-wide → text glued to the edge."""
    import re, unicodedata
    s = re.sub(r"\x1b\[[0-9;]*m", "", s)
    total = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        try:
            ea = unicodedata.east_asian_width(ch)
        except Exception:
            ea = "N"
        total += 2 if ea in ("W", "F") else 1
    return total


def print_box(title, lines):
    """Print a bordered menu box, centered on screen."""
    width = max(_vlen(l) for l in lines + [title]) + 6
    try:
        cols, rows = os.get_terminal_size()
    except OSError:
        cols, rows = 80, 24
    hpad = max(0, (cols - width) // 2)
    vpad = max(0, (rows - (3 + len(lines))) // 2)
    if vpad:
        print("\n" * vpad, end="")
    pad = " " * hpad
    print(pad + "╔" + "═" * (width - 2) + "╗")
    print(pad + f"║  {title}{' ' * max(1, width - 4 - _vlen(title))}║")
    print(pad + "╠" + "═" * (width - 2) + "╣")
    for l in lines:
        print(pad + f"║  {l}{' ' * max(1, width - 4 - _vlen(l))}║")
    print(pad + "╚" + "═" * (width - 2) + "╝")

def clear():
    os.system("clear" if os.name == "posix" else "cls")

def list_disks():
    out = run_capture(["/usr/bin/lsblk", "-J", "-o", "NAME,SIZE,TYPE,MODEL,MOUNTPOINT"])
    data = json.loads(out)
    disks = []
    for dev in data.get("blockdevices", []):
        if dev["type"] == "disk" and not any(dev["name"].startswith(p) for p in ("loop", "ram", "zram")):
            disks.append(dev)
    return disks

def select_disk(disks):
    """Select a disk by NUMBER (1..N) — no typing needed, layout-independent. Fallback: disk name."""
    _attempts = 0
    while True:
        clear()
        print("\n  SELECT TARGET DISK")
        for i, d in enumerate(disks, 1):
            print(f"  {i}) {d['name']:<10} {d['size']:<8} {d.get('model','')}")
        print("\n  WARNING: All data on the selected disk will be destroyed.\n")
        choice = ask(f"Select disk [1-{len(disks)}]", "").strip()
        if not choice:
            print("\n  No disk selected. Installation cancelled.")
            sys.exit(2)   # cancellation → setup.py returns to menu
        if choice.isdigit() and 1 <= int(choice) <= len(disks):
            return disks[int(choice) - 1]
        for d in disks:
            if d["name"] == choice:
                return d
        _attempts += 1
        print(f"\n  Invalid choice '{choice}'. Pick a number 1-{len(disks)} or a disk name (e.g. sda).")
        if _attempts >= 3:
            print("\n  Too many invalid attempts. Installation cancelled.")
            sys.exit(2)

def partition_and_format(disk):
    dev = f"/dev/{disk}"
    part1 = f"{dev}1" if not disk.startswith("nvme") else f"{dev}p1"
    part2 = f"{dev}2" if not disk.startswith("nvme") else f"{dev}p2"
    print(f"\n  Partitioning {dev}...")
    run(["/usr/bin/parted", "-s", dev, "mklabel", "gpt"])
    # BIOS Boot Partition (1 MiB, no filesystem) for GRUB embedding
    run(["/usr/bin/parted", "-s", dev, "mkpart", "primary", "1MiB", "2MiB"])
    run(["/usr/bin/parted", "-s", dev, "set", "1", "bios_grub", "on"])
    # Main root partition (rest of disk)
    run(["/usr/bin/parted", "-s", dev, "mkpart", "primary", "ext4", "2MiB", "100%"])
    subprocess.run(["/usr/bin/udevadm", "settle"], capture_output=True)
    run(["/usr/bin/parted", "-s", dev, "set", "2", "boot", "on"])
    print(f"  Formatting {part2} as ext4...")
    run(["/usr/sbin/mke2fs", "-t", "ext4", "-F", "-L", "AIOS", part2])
    return part2

def copy_system(target):
    print("\n  [4/7] Copying system files (this may take a while)...")
    excludes = [
        "--exclude=/proc/*", "--exclude=/sys/*", "--exclude=/dev/*",
        "--exclude=/run/*", "--exclude=/tmp/*", "--exclude=/mnt/*",
        "--exclude=/media/*", "--exclude=/lost+found",
        "--exclude=/swapfile",
    ]
    # Show the file currently being copied, one after another, on the same line
    # (rsync --out-format=%f emits one line per file with its path)
    cmd = ["/usr/bin/rsync", "-aHAX", "--out-format=%f"] + excludes + ["/", target]
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, bufsize=1)
    except FileNotFoundError:
        print("  ERROR: rsync not found")
        sys.exit(1)
    n = 0
    last_len = 0
    for line in p.stdout:
        name = line.rstrip("\n")
        if not name:
            continue
        n += 1
        shown = name if len(name) <= 50 else "..." + name[-47:]
        out = f"\r  [{n:>7}] {shown}"
        if len(out) < last_len:
            out += " " * (last_len - len(out))   # clear the rest of the previous line
        print(out, end="", flush=True)
        last_len = len(out)
    p.wait()
    print(f"\r  [{n:>7}] {n} files copied{' ' * 20}")
    if p.returncode != 0:
        sys.exit(p.returncode)

def setup_chroot(target):
    for d in ["dev", "proc", "sys", "run"]:
        Path(f"{target}/{d}").mkdir(parents=True, exist_ok=True)
    run(["/usr/bin/mount", "--bind", "/dev", f"{target}/dev"])
    run(["/usr/bin/mount", "--bind", "/proc", f"{target}/proc"])
    run(["/usr/bin/mount", "--bind", "/sys", f"{target}/sys"])
    run(["/usr/bin/mount", "--bind", "/run", f"{target}/run"])

def cleanup_chroot(target):
    for d in ["run", "sys", "proc", "dev"]:
        subprocess.run(["/usr/bin/umount", "-l", f"{target}/{d}"], capture_output=True)

def install_grub(target, disk, root_part):
    print(f"  Installing GRUB on /dev/{disk}...")
    run(["/usr/sbin/chroot", target, "/usr/sbin/grub-install", f"/dev/{disk}"])
    # Write fixed grub.cfg (grub-mkconfig generates graphical menu that hangs on VirtualBox)
    grub_cfg = Path(target) / "boot" / "grub" / "grub.cfg"
    grub_cfg.write_text(f"""set default=0
set timeout=0

menuentry "AIOS LFS" {{
    linux /boot/vmlinuz-6.18.10-lfs root={root_part} rw console=tty0 quiet loglevel=3 systemd.show_status=false
    initrd /boot/initrd.img
}}
""")

def generate_fstab(target, root_part):
    uuid = run_capture(["/usr/sbin/blkid", "-s", "UUID", "-o", "value", root_part])
    fstab = f"""# /etc/fstab: static file system information
UUID={uuid} / ext4 defaults,noatime 0 1
proc /proc proc nosuid,noexec,nodev 0 0
sys /sys sysfs nosuid,noexec,nodev 0 0
dev /dev devtmpfs mode=0755,nosuid 0 0
"""
    with open(f"{target}/etc/fstab", "w") as f:
        f.write(fstab)
    print(f"  fstab generated (UUID={uuid})")

def enable_services(target):
    print("  Enabling systemd services...")
    for svc in ["aios-llama.service", "sven-sync.service", "sven-sync.timer"]:
        run(["/usr/sbin/chroot", target, "systemctl", "enable", svc])

def persist_wifi(target):
    """Persist live WiFi configuration into the installed target."""
    live_confs = sorted(glob.glob("/etc/wpa_supplicant/wpa_supplicant-*.conf"))
    if not live_confs:
        return []

    target_wpa = Path(target) / "etc" / "wpa_supplicant"
    target_wpa.mkdir(parents=True, exist_ok=True)

    persisted = []
    for src in live_confs:
        src_path = Path(src)
        dst = target_wpa / src_path.name
        import shutil
        shutil.copy2(src_path, dst)
        os.chmod(dst, 0o600)
        iface = src_path.stem.split("-", 1)[1]
        run(["/usr/sbin/chroot", target, "systemctl", "enable", f"wpa_supplicant@{iface}"])
        persisted.append(iface)

    target_net = Path(target) / "etc" / "systemd" / "network"
    target_net.mkdir(parents=True, exist_ok=True)
    wifi_network = target_net / "20-wifi-dhcp.network"
    if not wifi_network.exists():
        wifi_network.write_text("[Match]\nName=wl*\n\n[Network]\nDHCP=ipv4\nDNS=208.67.222.222 208.67.220.220\n\n[DHCP]\nUseDNS=no\n")

    print(f"  WiFi config persisted for: {', '.join(persisted)}")
    return persisted

def configure_system(target):
    print("\n  Configuring system...")
    hostname = ask("Hostname for installed system", "aios")
    with open(f"{target}/etc/hostname", "w") as f:
        f.write(f"{hostname}\n")
    with open(f"{target}/etc/hosts", "w") as f:
        f.write(f"""127.0.0.1 localhost
127.0.1.1 {hostname}
::1 localhost ip6-localhost ip6-loopback
""")

def _live_layout():
    """Read the keyboard layout chosen in live mode (keyboard: in ~/.aios/config.yaml).
    The installer runs as root (Path.home()=/root) → try the real aios user path
    first. Returns None if there is no choice."""
    candidates = ["/home/aios/.aios/config.yaml", str(Path.home() / ".aios" / "config.yaml")]
    for p in candidates:
        try:
            import yaml
            with open(p) as f:
                data = yaml.safe_load(f) or {}
            kb = data.get("keyboard")
            if kb:
                return str(kb)
        except Exception:
            continue
    return None

def _detect_cpu():
    """Recommended threads (87.5% of cores) — mirror of setup.py detect_cpu()."""
    return max(1, int((os.cpu_count() or 4) * 0.875))


def _detect_ram_gb():
    """Total RAM in GB from /proc/meminfo — mirror of setup.py detect_ram_gb()."""
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    kb = int(line.split()[1])
                    return round(kb / 1024 / 1024)
    except Exception:
        pass
    return 12


def _auto_context(ram_gb):
    """Context by RAM (mirror of setup.py auto_context): <=8->8K, <=16->32K, >16->64K."""
    if ram_gb <= 8:
        return 8192
    elif ram_gb <= 16:
        return 32768
    return 65536


def setup_aios_config(target, mode="local", theme="wargames", layout=None, think=False, voice=None):
    aios_home = Path(target) / "home" / "aios" / ".aios"
    aios_home.mkdir(parents=True, exist_ok=True)
    uid = os.stat(Path(target) / "home" / "aios").st_uid
    gid = os.stat(Path(target) / "home" / "aios").st_gid
    # Layout: the one chosen in live mode (--layout) or persisted in its config.yaml
    if not layout:
        layout = _live_layout()
    # Cloud mode: copy config + API key already configured in live mode by setup
    if mode == "cloud":
        live_cfg = Path("/home/aios/.aios/config.yaml")
        if not live_cfg.exists():
            live_cfg = Path.home() / ".aios" / "config.yaml"
        live_env = Path("/home/aios/.aios/.env")
        if not live_env.exists():
            live_env = Path.home() / ".aios" / ".env"
        copied = False
        if live_cfg.exists():
            with open(live_cfg, "rb") as f:
                data = f.read()
            with open(aios_home / "config.yaml", "wb") as f:
                f.write(data)
            copied = True
        if live_env.exists():
            with open(live_env, "rb") as f:
                data = f.read()
            with open(aios_home / ".env", "wb") as f:
                f.write(data)
        # Ensure keyboard: in the copied config (when the installer receives --layout)
        if copied and layout:
            try:
                import yaml
                with open(aios_home / "config.yaml") as f:
                    data = yaml.safe_load(f) or {}
                data["keyboard"] = layout
                with open(aios_home / "config.yaml", "w") as f:
                    yaml.dump(data, f, default_flow_style=False)
            except Exception:
                pass
        for f in aios_home.iterdir():
            os.chown(f, uid, gid)
        if copied:
            print("  ~/.aios/config.yaml copied from live (cloud mode)")
        return
    models = list(Path(target + str(MODEL_SRC)).glob("*.gguf"))
    model_name = models[0].name if models else "Qwen_Qwen3.5-9B-Q4_K_M.gguf"
    config = {
        "mode": "local",
        "theme": theme,
        "keyboard": layout or "us",
        "local": {
            "model": model_name,
            "model_name": model_name.replace(".gguf", "").replace("Qwen_", "").replace("Instruct-", ""),
            "threads": _detect_cpu(),
            "context": _auto_context(_detect_ram_gb()),
            "think": think,
        },
        "cloud": {"provider": None, "model": None},
        "voice": voice or {"tts": "off", "stt": "off", "tts_lang": "auto"},
    }
    import yaml
    with open(aios_home / "config.yaml", "w") as f:
        yaml.dump(config, f, default_flow_style=False)
    # Copy live .env (cloud voice keys: GOOGLE/OPENAI_API_KEY) so
    # cloud voice engines also work on the installed disk.
    live_env = Path("/home/aios/.aios/.env")
    if not live_env.exists():
        live_env = Path.home() / ".aios" / ".env"
    if live_env.exists():
        with open(live_env, "rb") as f:
            data = f.read()
        with open(aios_home / ".env", "wb") as f:
            f.write(data)
    for f in aios_home.iterdir():
        os.chown(f, uid, gid)
    print("  ~/.aios/config.yaml created")

def apply_theme(target, theme):
    """Generate i3 colors.conf in the installed system with the chosen theme.
    aios-theme runs in the chroot (writes as root) → chown to aios uid/gid."""
    if not (Path(target) / "usr/local/bin/aios-theme").exists():
        return
    run(["chroot", target, "/usr/bin/env", "HOME=/home/aios",
         "/usr/local/bin/aios-theme", theme], check=False)
    uid = os.stat(Path(target) / "home" / "aios").st_uid
    gid = os.stat(Path(target) / "home" / "aios").st_gid
    for f in ("/home/aios/.config/i3/colors.conf", "/home/aios/.aios/config.yaml"):
        p = Path(target + f)
        if p.exists():
            os.chown(p, uid, gid)

def persist_keyboard(target, layout):
    """Persist keyboard layout + LARGE login font on the disk (/etc/vconsole.conf).

    The disk boots to a console login → KEYMAP=<chosen layout> + FONT=ter-232n
    (~triple font, Carlos decision 26 Aug: ONLY for the DISK login; the live
    uses autologin and keeps the tree's ter-112n font).
    Preserves other lines. Only acts if layout is a valid keymap in the tree:
    /usr/share/kbd/keymaps/**/<layout>.map.gz (otherwise warns and keeps current).
    systemd-vconsole-setup applies it at every boot → login with keyboard and large font.
    X11 is applied by aios-keyboard from keyboard: in ~/.aios/config.yaml (setup_aios_config)."""
    if not layout:
        return
    # Validate that the keymap exists in the installed system
    import glob
    found = glob.glob(f"{target}/usr/share/kbd/keymaps/**/{layout}.map.gz", recursive=True)
    if not found:
        print(f"  WARN: persist_keyboard: no keymap '{layout}' in the system, keeping current")
        return
    vc = Path(target) / "etc" / "vconsole.conf"
    lines = []
    if vc.exists():
        try:
            lines = [l for l in vc.read_text().splitlines()
                     if l.strip() and not l.strip().startswith("KEYMAP") and not l.strip().startswith("FONT")]
        except Exception:
            lines = []
    lines.append(f"KEYMAP={layout}")
    lines.append("FONT=ter-232n")
    vc.write_text("\n".join(lines) + "\n")
    print(f"  Keyboard layout {layout} + FONT=ter-232n persisted (disk login)")

def persist_ntp(target):
    """Copy live NTP config (if configured) and enable systemd-timesyncd on the disk."""
    src = "/etc/systemd/timesyncd.conf"
    try:
        if not Path(src).exists():
            return
        if "NTP=" not in Path(src).read_text():
            return
        dst = Path(target + src)
        dst.parent.mkdir(parents=True, exist_ok=True)
        with open(src, "rb") as f:
            data = f.read()
        with open(dst, "wb") as f:
            f.write(data)
        run(["chroot", target, "systemctl", "enable", "systemd-timesyncd"], check=False)
        print("  NTP config copied from live + timesyncd enabled")
    except Exception as e:
        print(f"  WARN: persist_ntp: {e}")


def persist_timezone(target):
    """Copy the live timezone (/etc/localtime) into the installed system.
    Preserves the symlink if it is one, else copies the bytes (so any tzdata
    zone chosen in live mode carries over to the disk)."""
    src = Path("/etc/localtime")
    try:
        if not src.exists():
            return
        dst = Path(target) / "etc" / "localtime"
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.is_symlink():
            link = os.readlink(src)
            dst.symlink_to(link)
        else:
            dst.write_bytes(src.read_bytes())
        print("  Timezone persisted to disk")
    except Exception as e:
        print(f"  WARN: persist_timezone: {e}")

def set_passwords(target):
    """REQUIRED: change root/aios passwords in the installed system."""
    print("\n  SECURITY: the live system uses factory passwords (root/root, aios/aios).")
    print("  The installed system MUST have its own passwords set.")

    def read_new_password(user):
        while True:
            p1 = _read_password(f"  New password for {user}: ")
            p2 = _read_password(f"  Repeat for {user}: ")
            if p1 != p2:
                print("  Passwords do not match.")
                continue
            return p1

    root_pass = read_new_password("root")
    if confirm("  Use the same password for aios"):
        aios_pass = root_pass
    else:
        aios_pass = read_new_password("aios")

    data = f"root:{root_pass}\naios:{aios_pass}\n".encode()
    try:
        subprocess.run(["/usr/sbin/chroot", target, "/usr/sbin/chpasswd"],
                       input=data, check=True, capture_output=True)
    except subprocess.CalledProcessError as e:
        print(f"  ERROR setting passwords: {e.stderr.strip()}")
        return False
    print("  Passwords updated.")
    return True


def harden_ssh(target):
    """Installed system: block root SSH with password (factory creds are public).
    Root stays reachable via public key (authorized_keys) or local console.
    """
    import re
    sshd_cfg = Path(target) / "etc" / "ssh" / "sshd_config"
    if not sshd_cfg.exists():
        print("  WARNING: sshd_config not found; SSH hardening skipped")
        return
    text = sshd_cfg.read_text()
    for directive, value in [("PermitRootLogin", "prohibit-password"),
                             ("PasswordAuthentication", "no"),
                             ("KbdInteractiveAuthentication", "no")]:
        if re.search(rf"^\s*{directive}\s", text, re.M):
            text = re.sub(rf"^\s*{directive}\s.*$", f"{directive} {value}", text, flags=re.M)
        else:
            text += f"\n{directive} {value}\n"
    sshd_cfg.write_text(text)
    # Ensure sshd is enabled on the installed system
    subprocess.run(["/usr/sbin/chroot", target, "systemctl", "enable", "sshd"],
                   capture_output=True)
    print("  SSH hardened: root only via key, password auth disabled")


def harden_login(target):
    """Installed system: require password for sudo and for console login.
    The LIVE keeps autologin + NOPASSWD; only the disk is hardened.
    MUST run after set_passwords() (aios needs a password for sudo)."""
    # 1. sudo: remove the NOPASSWD file for wheel (file-based, no globs —
    #    the 19-Aug lesson: globbing sudoers.d broke the installer)
    sudo_np = Path(target) / "etc/sudoers.d/wheel-nopasswd"
    if sudo_np.exists():
        sudo_np.unlink()
    # 2. console login: remove the autologin override of getty@tty1
    autologin = Path(target) / "etc/systemd/system/getty@tty1.service.d/noclear.conf"
    if autologin.exists():
        autologin.unlink()
    # 3. reload units + verify sudoers syntax
    subprocess.run(["/usr/sbin/chroot", target, "systemctl", "daemon-reload"],
                   capture_output=True)
    chk = subprocess.run(["/usr/sbin/chroot", target, "/usr/sbin/visudo", "-c"],
                         capture_output=True, text=True)
    if chk.returncode != 0:
        print(f"  WARNING: visudo check failed: {chk.stderr.strip()}")
    else:
        print("  Login hardened: sudo needs password, console login requires user/password")


def add_user_groups(target):
    """Add 'aios' to the standard desktop groups (video/audio/input/...).

    Without these, X cannot open /dev/dri/card0 (video), input devices
    (input), or ALSA (audio) → black screen / no keyboard / no sound.
    Groups are created if missing (groupadd -f), so this works on any
    hardware/installation, not just the reference laptop.
    """
    desktop_groups = [
        "video", "audio", "input", "storage", "optical", "power",
        "kvm", "render", "log", "rfkill", "disk", "cdrom", "dialout", "lp",
    ]
    print("  Adding aios to desktop groups:", ", ".join(desktop_groups))
    for group in desktop_groups:
        subprocess.run(["/usr/sbin/chroot", target, "/usr/bin/groupadd", "-f", group],
                       capture_output=True)
    subprocess.run(["/usr/sbin/chroot", target, "/usr/bin/usermod", "-aG",
                    ",".join(desktop_groups), "aios"], capture_output=True)
    print("  aios added to desktop groups (video/audio/input/...)")


def build_disk_initrd(target, root_part):
    """Transform the live initrd into a disk-boot initrd (clear + AIOS banner)."""
    import tempfile, shutil
    initrd_src = Path(target) / "boot" / "initrd.img"
    if not initrd_src.exists():
        print("  WARNING: initrd.img not copied; disk will boot without banner")
        return
    workdir = tempfile.mkdtemp(prefix="disk-initrd-")
    try:
        run(["/bin/busybox", "sh", "-c",
             f"cd {workdir} && /bin/busybox zcat {initrd_src} | /bin/busybox cpio -id"])
        init_path = Path(workdir) / "init"
        init = init_path.read_text()
        marker = "for dev in /dev/sr0"
        if marker not in init:
            print("  WARNING: initrd has no ISO loop; leaving as-is")
            return
        head = init.split(marker)[0]
        tail = """# Disk boot: mount root and switch to the real system
ROOT=$(/bin/busybox sed -n 's/.*root=\\([^ ]*\\).*/\\1/p' /proc/cmdline)
[ -z "$ROOT" ] && ROOT="%s"
i=0
while [ ! -b "$ROOT" ] && [ $i -lt 30 ]; do
    /bin/busybox sleep 1
    i=$((i+1))
done
/bin/busybox mkdir -p /root
if ! /bin/busybox mount -t ext4 "$ROOT" /root; then
    echo "AIOS: cannot mount $ROOT" > /dev/tty0
    exec /bin/busybox sh
fi
exec /bin/busybox switch_root /root /sbin/init
""" % root_part
        init_path.write_text(head + tail)
        run(["/bin/busybox", "sh", "-c",
             f"cd {workdir} && find . | /bin/busybox cpio -H newc -o | /bin/busybox gzip -9 > {initrd_src}"])
        print("  Disk initrd built (clear + banner + switch_root)")
        # Early CPU microcode: prepend the cpio — this kernel has NO LATE_LOADING,
        # so the initrd is the ONLY way to apply amd/intel microcode patches
        fw = Path(target) / "usr/lib/firmware"
        amd = sorted((fw / "amd-ucode").glob("microcode_amd*.bin")) if (fw / "amd-ucode").exists() else []
        intel = sorted((fw / "intel-ucode").glob("*")) if (fw / "intel-ucode").exists() else []
        if amd or intel:
            mcwork = tempfile.mkdtemp(prefix="early-mc-")
            try:
                mcsub = Path(mcwork) / "kernel/x86/microcode"
                mcsub.mkdir(parents=True)
                if amd:
                    (mcsub / "AuthenticAMD.bin").write_bytes(
                        b"".join(p.read_bytes() for p in amd))
                if intel:
                    (mcsub / "GenuineIntel.bin").write_bytes(
                        b"".join(p.read_bytes() for p in intel))
                run(["/bin/busybox", "sh", "-c",
                     f"cd {mcwork} && find kernel -type f | sort | "
                     f"/bin/busybox cpio -H newc -o 2>/dev/null > {mcwork}/microcode.cpio"])
                run(["/bin/busybox", "sh", "-c",
                     f"cat {mcwork}/microcode.cpio {initrd_src} > {mcwork}/initrd-early.img "
                     f"&& mv {mcwork}/initrd-early.img {initrd_src}"])
                print("  Early microcode prepended to disk initrd")
            finally:
                shutil.rmtree(mcwork, ignore_errors=True)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def main():
